{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "^/forge-spec",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .claude/hooks/forge-session-rename.sh ] && .claude/hooks/forge-session-rename.sh || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .claude/hooks/post-edit-format.sh ] && .claude/hooks/post-edit-format.sh $FILE_PATH || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x .claude/hooks/pre-compact-save.sh ] && .claude/hooks/pre-compact-save.sh || true"
          }
        ]
      }
    ]
  }
}
