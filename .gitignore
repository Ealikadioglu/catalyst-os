# Temporary spec files
.catalyst/specs/*/*.tmp

# Temp folder (research artifacts, screenshots, scratch files)
.catalyst/_temp-folder/

# Worktree directories (local working directories, not committed)
.catalyst/worktrees/

# Local secrets (BYOK — never commit)
.catalyst/secrets.local.yaml

# Voice meeting artifacts (local, not part of the framework)
.catalyst/meetings/

# A global gitignore (~/.config/git/ignore) commonly excludes .claude/.
# This repo ships the .claude framework, so re-include it or new skills,
# agents and rules are silently never committed.
!.claude/
.DS_Store
.claude/.DS_Store
