# A global gitignore (~/.config/git/ignore) excludes .claude/ and .catalyst/ in
# every project. That is right for projects that consume the framework and wrong
# for this one, which ships both. Re-include them first, then apply the specific
# ignores below, or new skills, agents, rules and schema files are silently never
# committed.
!.claude/
!.catalyst/

# Temporary spec files
.catalyst/specs/*/*.tmp

# Temp folder (research artifacts, screenshots, scratch files)
.catalyst/_temp-folder/

# Worktree directories (local working directories, not committed)
.catalyst/worktrees/

# Local secrets (BYOK — never commit)
.catalyst/secrets.local.yaml

# Voice meeting artifacts (local, not part of the framework)
.catalyst/meetings/

.DS_Store
.claude/.DS_Store
